# Qidiruv konsollari tasdiqlash kodlari (ixtiyoriy).
# Bo'sh qoldirilsa meta teg umuman chiqmaydi.
#
# Google Search Console → Settings → Ownership verification → HTML tag
# Ichidagi content="..." qiymatini shu yerga qo'ying (butun teg emas)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Yandex Webmaster → Настройки → Права доступа → Мета-тег
NEXT_PUBLIC_YANDEX_VERIFICATION=
